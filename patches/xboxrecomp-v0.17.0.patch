+
+/* Every sleep and wait of a worker, and the main thread's waits while
+ * lockstep is on. 1 = handled, *status is the call's result; 0 = do the call
+ * the normal way. `sleep`: the call is a delay (try_fn performs it). */
+static int ls_wait(ls_try_fn try_fn, void *ctx, uint32_t timeout_ptr,
+                   uint32_t ordinal, int sleep, uint32_t *status)
+{
+    LARGE_INTEGER zero;
+    zero.QuadPart = 0;
+    if (g_ls_slot >= 0) {
+        for (;;) {
+            if (s_ls_on) {
+                if (!ls_park(ordinal))
+                    continue;                   /* went off while parked */
+                if (sleep) {                    /* the turn is the sleep's end */
+                    *status = 0;
+                    return 1;
+                }
+                *status = try_fn(ctx, &zero);
+                if (*status != 0x102u || timeout_ptr)   /* STATUS_TIMEOUT */
+                    return 1;
+                continue;
+            }
+            ls_set_blocked(1);
+            *status = try_fn(ctx, XBOX_TO_NATIVE(timeout_ptr));
+            ls_set_blocked(0);
+            if (s_ls_on)                        /* woken with lockstep on: */
+                ls_park(ordinal);               /* run on in a turn only */
+            return 1;
+        }
+    }
+    if (!s_ls_on)
+        return 0;
+    if (sleep) {
+        /* The main thread polling for a worker's result ("while (!done)
+         * Sleep(1)", the cache file copy mid-match): each pass is a turn for
+         * the workers, or they never finish. Then the sleep, as usual. */
+        if (g_is_main_guest)
+            xbox_LockstepPump(2000);
+        return 0;
+    }
+    if (g_is_main_guest) {
+        /* Look; then, until the wait is satisfied or its own timeout is up,
+         * give the workers a turn and wait a little on the host (a file read
+         * or a DPC may be what it waits for). A job can take a worker several
+         * turns: one pump and then a host wait left the main thread blocked
+         * on a job whose worker sat parked. */
+        LARGE_INTEGER slice;
+        int64_t left = -1;                      /* 100 ns units; -1 = INFINITE */
+        unsigned rounds = 0;
+        *status = try_fn(ctx, &zero);
+        if (*status != 0x102u)
+            return 1;
+        if (timeout_ptr) {
+            int64_t t = (int64_t)((uint64_t)BRIDGE_MEM32(timeout_ptr)
+                                  | ((uint64_t)BRIDGE_MEM32(timeout_ptr + 4) << 32));
+            if (t == 0)
+                return 1;                       /* it asked for a look only */
+            if (t > 0)
+                return 0;                       /* an absolute time: the normal way */
