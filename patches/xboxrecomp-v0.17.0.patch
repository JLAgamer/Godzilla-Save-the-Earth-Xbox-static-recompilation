+/* Until every worker is parked (lockstep just turned on: they park at their
+ * next sleep or wait). Returns how many are not, after timeout_ms. */
+int xbox_LockstepQuiesce(unsigned timeout_ms)
+{
+    int k, missed = 0;
+    InitOnceExecuteOnce(&s_ls_once, ls_init, NULL, NULL);
+    EnterCriticalSection(&s_ls_lock);
+    for (k = 0; k < LS_MAX; k++)
+        if (s_ls_state[k] == LS_RUNNING && !ls_await(k, s_ls_parks[k] - 1u, timeout_ms)) {
+            fprintf(stderr, "  [LOCKSTEP] worker %d does not park\n", k);
+            missed++;
+        }
+    LeaveCriticalSection(&s_ls_lock);
+    return missed;
