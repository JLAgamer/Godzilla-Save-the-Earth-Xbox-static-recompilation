@@ -278,7 +279,55 @@ void mcpx_apu_dsp_frame(MCPXAPUState *d,
              * counts. This is not what a real EP does; it is the cheapest
              * mixdown that stops discarding audio. */
             float left, right;
-            if (mcpx_apu_mixdown_all()) {
+            /* RECOMP_APU_MIXDOWN=pairs: the even-left / odd-right sum above.
+             * Default: a speaker downmix of the XDK DirectSound bins --
+             * 0 FL, 1 FR, 2 C, 3 LFE, 4 BL, 5 BR, then the 3D (XTLK) set
+             * 6 FL, 7 FR, 8 BL, 9 BR, 10 C, 11 LFE -- with centre and LFE to
+             * both ears. Under even/odd, centre landed in the left ear only
+             * and LFE in the right, so music routed to the centre played
+             * from one side (Godzilla). Bins 12+ (I3DL2 reverb and FX sends)
+             * feed the GP's effects, which nothing runs; they still carry
+             * sound some titles only route there, so they go to both ears
+             * at reduced level instead of being dropped. */
+            static int pairs = -1;
+            if (pairs < 0) {
+                const char *e = getenv("RECOMP_APU_MIXDOWN");
+                pairs = e && strcmp(e, "pairs") == 0;
+            }
+            if (mcpx_apu_mixdown_all() && !pairs) {
+                const float c = 0.7071f, rear = 0.7071f, fx = 0.5f;
+                /* The 3D (XTLK) bins carry each positional voice spread over
+                 * up to six speakers; on hardware the DSP's crosstalk stage
+                 * folds them to about front level. Summed raw they peaked at
+                 * 1.2-1.4x full scale in Godzilla's fights (crunch), and even
+                 * at 0.5 they buried the music, so the group is weighted
+                 * 0.35. RECOMP_APU_3D_GAIN overrides.
+                 *
+                 * LFE: a stereo downmix drops it (ITU: L = FL + .707 C +
+                 * .707 BL). Godzilla sends its music to all six speaker bins
+                 * at equal level; with LFE folded in at 0.5 the music came
+                 * out muddy and unbalanced. RECOMP_APU_LFE_GAIN overrides 0. */
+                static float g3 = -1.0f, lfe = -1.0f;
+                float send = 0.0f;
+                if (g3 < 0.0f) {
+                    const char *e = getenv("RECOMP_APU_3D_GAIN");
+                    g3 = e ? (float)atof(e) : 0.35f;
+                    e = getenv("RECOMP_APU_LFE_GAIN");
+                    lfe = e ? (float)atof(e) : 0.0f;
+                }
+                left  = mixbins[0][i] + c * mixbins[2][i] + lfe * mixbins[3][i]
+                      + rear * mixbins[4][i]
+                      + g3 * (mixbins[6][i] + rear * mixbins[8][i]
+                              + c * mixbins[10][i] + lfe * mixbins[11][i]);
+                right = mixbins[1][i] + c * mixbins[2][i] + lfe * mixbins[3][i]
+                      + rear * mixbins[5][i]
+                      + g3 * (mixbins[7][i] + rear * mixbins[9][i]
+                              + c * mixbins[10][i] + lfe * mixbins[11][i]);
+                for (int b = 12; b < NUM_MIXBINS; ++b)
+                    send += mixbins[b][i];
+                left  += fx * send;
+                right += fx * send;
+            } else if (mcpx_apu_mixdown_all()) {
                 left = 0.0f;
                 right = 0.0f;
                 for (int b = 0; b < NUM_MIXBINS; ++b) {
@@ -289,6 +338,60 @@ void mcpx_apu_dsp_frame(MCPXAPUState *d,
                 left = mixbins[0][i];
                 right = mixbins[1][i];
             }
+            /* Summing every bin overshoots full scale whenever several loud
+             * voices play at once (Godzilla's roars and explosions), and the
+             * hard clamp below is then audible as crunchy distortion. A peak
+             * limiter first: the envelope jumps to any new peak at once and
+             * decays over ~120 ms (48 kHz), and the pair is scaled so the
+             * envelope never exceeds 0.9. Quiet passages pass untouched.
+             * RECOMP_APU_LIMITER=0 leaves the clamp alone. */
+            {
+                static int lim = -1, lv = -1;
+                static float env;
+                /* RECOMP_APU_LEVELS=1: once a second, the peak of each bin
+                 * group, the mixed peak before limiting, and how many samples
+                 * the limiter turned down -- which says whether distortion
+                 * is overload or already in one group's source audio. */
+                static float g_pk[7], mix_pk;
+                static uint32_t n_smp, n_lim;
+                if (lim < 0) {
+                    const char *e = getenv("RECOMP_APU_LIMITER");
+                    lim = !(e && e[0] == '0');
+                    lv = getenv("RECOMP_APU_LEVELS") != NULL;
+                }
+                if (lv) {
+                    static const int grp[NUM_MIXBINS] = {
+                        0, 0, 1, 2, 3, 3, 4, 4, 4, 4, 4, 4 };  /* 12+ -> 5 */
+                    float m = fabsf(left) > fabsf(right) ? fabsf(left) : fabsf(right);
+                    for (int b = 0; b < NUM_MIXBINS; ++b) {
+                        int gi = b < 12 ? grp[b] : 5;
+                        float a = fabsf(mixbins[b][i]);
+                        if (a > g_pk[gi]) g_pk[gi] = a;
+                    }
+                    if (m > mix_pk) mix_pk = m;
+                    n_smp++;
+                    if (lim && (env * 0.999826f > 0.9f || m > 0.9f)) n_lim++;
+                    if (n_smp >= 48000) {
+                        fprintf(stderr, "[APU-LEVEL] peaks front %.2f centre %.2f lfe %.2f rear %.2f 3d %.2f fx %.2f"
+                                " | mix %.2f limited %.0f%%\n",
+                                g_pk[0], g_pk[1], g_pk[2], g_pk[3], g_pk[4], g_pk[5],
+                                mix_pk, n_lim * 100.0 / n_smp);
+                        memset(g_pk, 0, sizeof g_pk);
+                        mix_pk = 0.0f;
+                        n_smp = n_lim = 0;
+                    }
+                }
+                if (lim) {
+                    float pk = fabsf(left) > fabsf(right) ? fabsf(left) : fabsf(right);
+                    env *= 0.999826f;                   /* e^(-1/5760) */
+                    if (pk > env) env = pk;
+                    if (env > 0.9f) {
+                        float g = 0.9f / env;
+                        left *= g;
+                        right *= g;
+                    }
+                }
+            }
