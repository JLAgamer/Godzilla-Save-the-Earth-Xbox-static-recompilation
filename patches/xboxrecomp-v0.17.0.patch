+static int          g_sdl = -1;           /* -1 not decided, 0 off, 1 on */
+static SDL_Gamepad *g_sdl_pad[XBOX_MAX_CONTROLLERS];
+static DWORD        g_sdl_packet[XBOX_MAX_CONTROLLERS];
+static XBOX_GAMEPAD g_sdl_last[XBOX_MAX_CONTROLLERS];
+static ULONGLONG    g_sdl_updated, g_sdl_scanned;
+static int          g_sdl_background;
+static CRITICAL_SECTION g_sdl_lock;
+
+static int sdl_on(void)
+{
+    if (g_sdl < 0) {
+        const char *p = getenv("RECOMP_PAD"), *bg = getenv("RECOMP_PAD_BACKGROUND");
+        WCHAR dll[MAX_PATH], *slash;
+        g_sdl = 0;
+        GetModuleFileNameW(NULL, dll, MAX_PATH);
+        if ((slash = wcsrchr(dll, L'\\')) != NULL) slash[1] = 0;
+        wcscat_s(dll, MAX_PATH, L"SDL3.dll");
+        if (p && !_stricmp(p, "xinput")) return 0;
+        if (GetFileAttributesW(dll) == INVALID_FILE_ATTRIBUTES) {
+            fprintf(stderr, "[INPUT] SDL3.dll not next to the program: XInput pads only\n");
+            return 0;
+        }
+        InitializeCriticalSection(&g_sdl_lock);
+        /* the game has no SDL window: let SDL see pads without one */
+        SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+        if (!SDL_Init(SDL_INIT_GAMEPAD)) {
+            fprintf(stderr, "[INPUT] SDL3 could not start (%s): XInput pads only\n", SDL_GetError());
+            return 0;
+        }
+        g_sdl_background = bg && *bg == '1';
+        g_sdl = 1;
+        fprintf(stderr, "[INPUT] SDL3 %d.%d.%d gamepads\n", SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_MICRO_VERSION);
+    }
+    return g_sdl;
+}
+
+/* Open new pads into free ports, close unplugged ones. Under g_sdl_lock. */
+static void sdl_scan(void)
+{
+    int n = 0, i, port;
+    SDL_JoystickID *ids;
+    for (port = 0; port < XBOX_MAX_CONTROLLERS; port++)
+        if (g_sdl_pad[port] && !SDL_GamepadConnected(g_sdl_pad[port])) {
+            fprintf(stderr, "[INPUT] port %d: pad unplugged\n", port + 1);
+            SDL_CloseGamepad(g_sdl_pad[port]);
+            g_sdl_pad[port] = NULL;
+        }
+    if ((ids = SDL_GetGamepads(&n)) == NULL) return;
+    for (i = 0; i < n; i++) {
+        int open = 0;
+        for (port = 0; port < XBOX_MAX_CONTROLLERS; port++)
+            if (g_sdl_pad[port] && SDL_GetGamepadID(g_sdl_pad[port]) == ids[i]) open = 1;
+        if (open) continue;
+        for (port = 0; port < XBOX_MAX_CONTROLLERS && g_sdl_pad[port]; port++) {}
+        if (port == XBOX_MAX_CONTROLLERS) break;
+        if ((g_sdl_pad[port] = SDL_OpenGamepad(ids[i])) != NULL)
+            fprintf(stderr, "[INPUT] port %d: %s\n", port + 1, SDL_GetGamepadName(g_sdl_pad[port]));
+    }
+    SDL_free(ids);
+}
+
+static void sdl_update(void)
+{
+    ULONGLONG now = GetTickCount64();
+    if (now != g_sdl_updated) { SDL_UpdateGamepads(); g_sdl_updated = now; }
+    if (now - g_sdl_scanned >= 500) { sdl_scan(); g_sdl_scanned = now; }
+}
