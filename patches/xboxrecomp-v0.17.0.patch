+/* What the main thread and the workers are doing (a watchdog's report). */
+void xbox_LockstepDump(void)
+{
+    static const char *names[] = { "free", "running", "parked", "granted", "blocked" };
+    int k;
+    fprintf(stderr, "  [LOCKSTEP] main: %s ordinal %u (guest return 0x%08X), %ld"
+            " lockstep wait slices, %u critical-section pumps\n",
+            s_ls_main_in ? "in" : "last", s_ls_main_ord, s_ls_main_ret,
+            s_ls_main_waits, s_ls_main_cs);
+    if (s_ls_main_esp) {
