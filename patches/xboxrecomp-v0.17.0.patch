+        fprintf(stderr, "  [LOCKSTEP] main guest stack from 0x%08X:", s_ls_main_esp);
+        for (i = 0; i < 256 && n < 24; i++) {
+            uint32_t v = BRIDGE_MEM32(s_ls_main_esp + i * 4);
+            if (v >= 0x00011000u && v < 0x002E0000u) {
+                fprintf(stderr, " %08X", v);
+                n++;
