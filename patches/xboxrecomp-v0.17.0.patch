+typedef uint32_t (*ls_try_fn)(void *ctx, PLARGE_INTEGER timeout);
+
+/* A worker in a sleep or wait the normal way (lockstep off when it began):
+ * idle, so it counts as parked, but it must not run on from it while
+ * lockstep is on. */
+static void ls_set_blocked(int on)
+{
+    int k = g_ls_slot;
+    EnterCriticalSection(&s_ls_lock);
+    s_ls_state[k] = on ? LS_BLOCKED : LS_RUNNING;
+    WakeAllConditionVariable(&s_ls_cv);
+    LeaveCriticalSection(&s_ls_lock);
