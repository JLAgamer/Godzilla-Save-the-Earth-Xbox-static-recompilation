+        fprintf(stderr, "%c", 10);
+    }
+    for (k = 0; k < LS_MAX; k++)
+        if (s_ls_state[k] != LS_FREE)
+            fprintf(stderr, "  [LOCKSTEP] worker %d: %s, parked last at ordinal %u, %u parks;"
+                    " latest kernel call %u (guest return 0x%08X)\n", k,
+                    names[s_ls_state[k]], s_ls_where[k], s_ls_parks[k],
+                    s_ls_cur_ord[k], s_ls_cur_ret[k]);
