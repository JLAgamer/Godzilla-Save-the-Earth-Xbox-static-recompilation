+/* An XInput pad through the pad mapping, when a game set one. */
+static void xinput_remap(const XINPUT_STATE *xi, XBOX_GAMEPAD *out)
+{
+    InputRaw raw;
+    WORD b = xi->Gamepad.wButtons;
+    memset(&raw, 0, sizeof raw);
+    raw.src[INPUT_SRC_SOUTH] = (b & XINPUT_GAMEPAD_A) ? 32767 : 0;
+    raw.src[INPUT_SRC_EAST] = (b & XINPUT_GAMEPAD_B) ? 32767 : 0;
+    raw.src[INPUT_SRC_WEST] = (b & XINPUT_GAMEPAD_X) ? 32767 : 0;
+    raw.src[INPUT_SRC_NORTH] = (b & XINPUT_GAMEPAD_Y) ? 32767 : 0;
+    raw.src[INPUT_SRC_BACK] = (b & XINPUT_GAMEPAD_BACK) ? 32767 : 0;
+    raw.src[INPUT_SRC_START] = (b & XINPUT_GAMEPAD_START) ? 32767 : 0;
+    raw.src[INPUT_SRC_LEFT_STICK_CLICK] = (b & XINPUT_GAMEPAD_LEFT_THUMB) ? 32767 : 0;
+    raw.src[INPUT_SRC_RIGHT_STICK_CLICK] = (b & XINPUT_GAMEPAD_RIGHT_THUMB) ? 32767 : 0;
+    raw.src[INPUT_SRC_LEFT_SHOULDER] = (b & XINPUT_GAMEPAD_LEFT_SHOULDER) ? 32767 : 0;
+    raw.src[INPUT_SRC_RIGHT_SHOULDER] = (b & XINPUT_GAMEPAD_RIGHT_SHOULDER) ? 32767 : 0;
+    raw.src[INPUT_SRC_DPAD_UP] = (b & XINPUT_GAMEPAD_DPAD_UP) ? 32767 : 0;
+    raw.src[INPUT_SRC_DPAD_DOWN] = (b & XINPUT_GAMEPAD_DPAD_DOWN) ? 32767 : 0;
+    raw.src[INPUT_SRC_DPAD_LEFT] = (b & XINPUT_GAMEPAD_DPAD_LEFT) ? 32767 : 0;
+    raw.src[INPUT_SRC_DPAD_RIGHT] = (b & XINPUT_GAMEPAD_DPAD_RIGHT) ? 32767 : 0;
+    raw.src[INPUT_SRC_LEFT_TRIGGER] = (int16_t)(xi->Gamepad.bLeftTrigger * 32767 / 255);
+    raw.src[INPUT_SRC_RIGHT_TRIGGER] = (int16_t)(xi->Gamepad.bRightTrigger * 32767 / 255);
+    raw.lx = xi->Gamepad.sThumbLX; raw.ly = xi->Gamepad.sThumbLY;
+    raw.rx = xi->Gamepad.sThumbRX; raw.ry = xi->Gamepad.sThumbRY;
+    raw.src[INPUT_SRC_LSTICK_UP] = raw.ly > 0 ? raw.ly : 0;
+    raw.src[INPUT_SRC_LSTICK_DOWN] = raw.ly < 0 ? (int16_t)(raw.ly == -32768 ? 32767 : -raw.ly) : 0;
+    raw.src[INPUT_SRC_LSTICK_LEFT] = raw.lx < 0 ? (int16_t)(raw.lx == -32768 ? 32767 : -raw.lx) : 0;
+    raw.src[INPUT_SRC_LSTICK_RIGHT] = raw.lx > 0 ? raw.lx : 0;
+    raw.src[INPUT_SRC_RSTICK_UP] = raw.ry > 0 ? raw.ry : 0;
+    raw.src[INPUT_SRC_RSTICK_DOWN] = raw.ry < 0 ? (int16_t)(raw.ry == -32768 ? 32767 : -raw.ry) : 0;
+    raw.src[INPUT_SRC_RSTICK_LEFT] = raw.rx < 0 ? (int16_t)(raw.rx == -32768 ? 32767 : -raw.rx) : 0;
+    raw.src[INPUT_SRC_RSTICK_RIGHT] = raw.rx > 0 ? raw.rx : 0;
+    xbox_InputMap_PadMap(&g_padmap, &raw, out);
+}
