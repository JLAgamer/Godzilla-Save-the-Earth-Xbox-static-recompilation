+         * sequence - select the voice (0x202F8), lock (0x202FC = 1), values,
+         * unlock - at raised IRQL, where nothing else runs on the console.
+         * Count sequences another thread writes into: its select replaces
+         * this one's, and the values land on the wrong voice. */
+        static int on = -1;
+        static volatile LONG owner, races, seqs;
+        if (on < 0) on = getenv("RECOMP_APU_RACE_LOG") != NULL;
+        if (on && addr >= 0x202F8 && addr < 0x20400) {
+            LONG me = (LONG)GetCurrentThreadId(), o = owner;
+            if (o && o != me) {
