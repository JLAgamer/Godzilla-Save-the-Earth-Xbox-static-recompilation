+
+/* Each parked worker, in spawn order, runs one turn: until it parks again.
+ * Returns how many did not come back within timeout_ms (they are then left
+ * running, and the caller should know its state is not exact). */
+int xbox_LockstepPump(unsigned timeout_ms)
+{
+    int k, missed = 0;
+    if (!s_ls_on)
+        return 0;
+    EnterCriticalSection(&s_ls_lock);
+    for (k = 0; k < LS_MAX; k++) {
+        uint32_t parks;
+        if (s_ls_state[k] == LS_FREE)
+            continue;
+        if (s_ls_state[k] != LS_PARKED && !ls_await(k, s_ls_parks[k] - 1u, timeout_ms)) {
+            missed++;
+            continue;
