@@ -1746,3 +1812,101 @@ static void mixer_render(int16_t frame_buf[][2], int num_samples)
     }
     LeaveCriticalSection(&g_mixer_cs);
 }
+
+/* ============================================================
+ * Rollback support (a game that puts guest memory back in time)
+ *
+ * The APU's guest-visible state that lives on the host: the register file
+ * (the front end's trap and its method/parameter, the interrupt status, the
+ * voice list heads), the GP and EP register blocks, the voices' SSL data and
+ * the sequencer's sample counter. The voices themselves are in guest memory
+ * and go back with it; this goes back beside them, or a trap raised for a
+ * voice the rollback removed is serviced afterwards against a voice table
+ * that no longer holds it (the DirectSound service routine read 0xFFFFFFBE).
+ *
+ * Save and load hold d->lock, which the frame thread keeps except between
+ * frames and while it delivers the interrupt; the caller holds the one-CPU
+ * gate, so a delivery is posted and runs only at the caller's release. The
+ * audio itself (resamplers, filters, the host queue) is not included: it
+ * plays on. */
+typedef struct {
+    uint32_t regs[0x20000];
+    uint32_t gp_regs[0x10000];
+    uint32_t ep_regs[0x10000];
+    MCPXAPUVPSSLData ssl[MCPX_HW_MAX_VOICES];
+    int ssl_base_page;
+    uint64_t sample_count;
+    int set_irq;
+} ApuSnapshot;
+
+/* Hold the APU between frames (recursive: save and load take it again). A
+ * caller that also takes a lock the frame thread can want while it holds
+ * this one (the rollback's page-fault logger) takes this one first. */
+void xbox_ApuLock(void)
+{
+    if (g_state)
+        qemu_mutex_lock(&g_state->lock);
+}
+
+void xbox_ApuUnlock(void)
+{
+    if (g_state)
+        qemu_mutex_unlock(&g_state->lock);
+}
+
+size_t xbox_ApuStateSize(void)
+{
+    return sizeof(ApuSnapshot);
+}
+
+int xbox_ApuStateSave(void *buf)
+{
+    MCPXAPUState *d = g_state;
+    ApuSnapshot *s = (ApuSnapshot *)buf;
+    if (!d)
+        return 0;
+    qemu_mutex_lock(&d->lock);
+    memcpy(s->regs, (const void *)d->regs, sizeof s->regs);
+    memcpy(s->gp_regs, d->gp.regs, sizeof s->gp_regs);
+    memcpy(s->ep_regs, d->ep.regs, sizeof s->ep_regs);
+    memcpy(s->ssl, d->vp.ssl, sizeof s->ssl);
+    s->ssl_base_page = d->vp.ssl_base_page;
+    s->sample_count = d->sample_count;
+    s->set_irq = d->set_irq;
+    qemu_mutex_unlock(&d->lock);
+    return 1;
+}
+
+int xbox_ApuStateLoad(const void *buf)
+{
+    MCPXAPUState *d = g_state;
+    const ApuSnapshot *s = (const ApuSnapshot *)buf;
+    if (!d)
+        return 0;
+    qemu_mutex_lock(&d->lock);
+    memcpy((void *)d->regs, s->regs, sizeof s->regs);
+    memcpy(d->gp.regs, s->gp_regs, sizeof s->gp_regs);
+    memcpy(d->ep.regs, s->ep_regs, sizeof s->ep_regs);
+    memcpy(d->vp.ssl, s->ssl, sizeof s->ssl);
+    d->vp.ssl_base_page = s->ssl_base_page;
+    d->sample_count = s->sample_count;
+    d->set_irq = s->set_irq != 0;
+    update_irq(d);                      /* the line follows ISTS / IEN */
+    qemu_cond_broadcast(&d->cond);      /* FECTL may have changed */
+    qemu_mutex_unlock(&d->lock);
+    return 1;
+}
+
+/* The registers a stall report wants (the rollback's watchdog). */
+void xbox_ApuDump(void)
+{
+    MCPXAPUState *d = g_state;
+    if (!d)
+        return;
+    fprintf(stderr, "  [APU] ISTS=%08X IEN=%08X FECTL=%08X FEDECMETH=%08X FEDECPARAM=%08X"
+            " SECTL=%08X line=%ld idle=%d pause=%d\n",
+            d->regs[NV_PAPU_ISTS], d->regs[NV_PAPU_IEN], d->regs[NV_PAPU_FECTL],
+            d->regs[NV_PAPU_FEDECMETH], d->regs[NV_PAPU_FEDECPARAM],
+            d->regs[NV_PAPU_SECTL], (long)s_irq_line, d->is_idle, d->pause_requested);
+    fflush(stderr);
+}
