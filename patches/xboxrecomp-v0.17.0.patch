+                if (n <= 5 || n % 200 == 0)
+                    fprintf(stderr, "[APU-RACE] thread %ld wrote 0x%05X = %08X inside thread %ld's locked sequence (%ld so far, %ld sequences)\n",
+                            (long)me, (unsigned)addr, (unsigned)val, (long)o, (long)n, (long)seqs);
+            }
+            if (addr == 0x202FC) {
+                if (val & 1) { owner = me; InterlockedIncrement(&seqs); }
+                else if (owner == me) owner = 0;
+            }
