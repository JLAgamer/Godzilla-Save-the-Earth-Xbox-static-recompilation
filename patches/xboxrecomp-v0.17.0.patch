+ * The main thread's own waits look once and, when that finds nothing, pump
+ * the workers once before they block for real: a main thread waiting for a
+ * job a parked worker has not done would otherwise wait forever. */
+#define LS_MAX 32
+enum { LS_FREE, LS_RUNNING, LS_PARKED, LS_GRANTED, LS_BLOCKED };
+static CRITICAL_SECTION s_ls_lock;
+static CONDITION_VARIABLE s_ls_cv;
+static INIT_ONCE s_ls_once = INIT_ONCE_STATIC_INIT;
+static volatile LONG s_ls_on;
+static int s_ls_state[LS_MAX];
+static uint32_t s_ls_parks[LS_MAX], s_ls_where[LS_MAX];
+static RECOMP_TLS int g_ls_slot = -1;
+static RECOMP_TLS int g_is_main_guest = 0;
+static volatile uint32_t s_ls_main_ord, s_ls_main_ret, s_ls_main_in, s_ls_main_cs, s_ls_main_esp;
+static volatile LONG s_ls_main_waits;
+static volatile uint32_t s_ls_cur_ord[32], s_ls_cur_ret[32];
+
+static BOOL CALLBACK ls_init(PINIT_ONCE o, PVOID p, PVOID *c)
+{
+    (void)o; (void)p; (void)c;
+    InitializeCriticalSection(&s_ls_lock);
+    InitializeConditionVariable(&s_ls_cv);
+    return TRUE;
+}
+
+static void ls_register(void)
+{
+    int k;
+    InitOnceExecuteOnce(&s_ls_once, ls_init, NULL, NULL);
+    EnterCriticalSection(&s_ls_lock);
+    for (k = 0; k < LS_MAX; k++)
+        if (s_ls_state[k] == LS_FREE) {
+            s_ls_state[k] = LS_RUNNING;
+            g_ls_slot = k;
+            break;
+        }
+    LeaveCriticalSection(&s_ls_lock);
+}
+
+static void ls_unregister(void)
+{
+    if (g_ls_slot < 0)
+        return;
+    EnterCriticalSection(&s_ls_lock);
+    s_ls_state[g_ls_slot] = LS_FREE;
+    WakeAllConditionVariable(&s_ls_cv);
+    LeaveCriticalSection(&s_ls_lock);
+    g_ls_slot = -1;
+}
+
+/* A worker at a sleep or wait: 1 once it has been granted a turn, 0 at once
+ * when lockstep is off (or goes off while parked): wait the normal way. */
+static int ls_park(uint32_t ordinal)
+{
+    int k = g_ls_slot;
+    if (k < 0 || !s_ls_on)
+        return 0;
+    EnterCriticalSection(&s_ls_lock);
+    s_ls_state[k] = LS_PARKED;
+    s_ls_where[k] = ordinal;
+    s_ls_parks[k]++;
+    WakeAllConditionVariable(&s_ls_cv);
+    while (s_ls_state[k] == LS_PARKED && s_ls_on)
+        SleepConditionVariableCS(&s_ls_cv, &s_ls_lock, INFINITE);
+    s_ls_state[k] = LS_RUNNING;
+    LeaveCriticalSection(&s_ls_lock);
+    return s_ls_on != 0;
+}
+
+/* Wait (under s_ls_lock) until worker k is parked again after `parks`, or
+ * gone. 0 on timeout. */
+static int ls_await(int k, uint32_t parks, DWORD timeout_ms)
+{
+    ULONGLONG t0 = GetTickCount64();
+    while (s_ls_state[k] != LS_FREE && s_ls_state[k] != LS_BLOCKED
+           && !(s_ls_state[k] == LS_PARKED && s_ls_parks[k] != parks)) {
+        ULONGLONG used = GetTickCount64() - t0;
+        if (used >= timeout_ms)
+            return 0;
+        SleepConditionVariableCS(&s_ls_cv, &s_ls_lock, (DWORD)(timeout_ms - used));
+    }
+    return 1;
+}
