@@ -139,6 +139,49 @@ uint8_t *mcpx_apu_phys(uint64_t addr)
  * where the host mapped RAM) or "wrap" (above the mapping, folded into the
  * low 64 MB). A voice reading noise from "wrap" or "hiwin" is the address
  * resolution, not the decoder. */
+/* mcpx_apu_phys for a voice's SAMPLE data (not the APU's own structures).
+ *
+ * A heap page carries the RAM mark only once the title has asked for its
+ * physical address (xbox_PhysNoteRamName), and the mark goes when the heap
+ * block is freed. Godzilla's sound banks live in the heap; pages of banks
+ * whose mark was missing resolved to the contiguous window wherever the
+ * window had also handed out that number, and the effect voices played the
+ * window's bytes: in two runs every such voice had valid ADPCM in RAM (16 of
+ * 16 block headers) and mostly not in the window (3-6 of 16) - harsh noise on
+ * menu UI sounds and in the attract fight. Sample data inside a live heap
+ * block is therefore read from RAM. The APU's own structures (voice array,
+ * SGE and SSL tables, notifiers) are allocated contiguous and keep the plain
+ * rules. RECOMP_APU_HEAP_SAMPLES=0: plain rules for samples too. */
+uint8_t *mcpx_apu_phys_sample(uint64_t addr)
+{
+    static int on = -1;
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_APU_HEAP_SAMPLES");
+        on = !(e && e[0] == '0');
+    }
+    if (on && a < (64u << 20) && xbox_ContiguousPageMap()[a >> 12]
+            && !xbox_PhysRamNamedAt(a) && xbox_HeapLiveAt(a)) {
+        static volatile long n;
+        if (++n <= 3 || n % 100000 == 0)
+            fprintf(stderr, "[APU] sample data at %08X: inside a live heap block, read from RAM (%ld)\n", a, n);
+        return g_apu_ram_ptr + a;
+    }
+    if (on && a < (64u << 20) && xbox_ContiguousPageMap()[a >> 12] && !xbox_PhysRamNamedAt(a)
+            && getenv("RECOMP_APU_TRACE")) {
+        /* Diagnostics: sample data read from the window; what does the heap say? */
+        static uint8_t seen[(64u << 20) >> 16];
+        if (!seen[a >> 16]) {
+            uint32_t ba = 0, bs = 0;
+            int fr = 0, nm = 0, have = xbox_HeapBlockInfo(a, &ba, &bs, &fr, &nm);
+            seen[a >> 16] = 1;
+            fprintf(stderr, "[APU-WIN] sample data at %08X read from the window; heap block %s%08X+%X%s%s\n", a,
+                    have ? "" : "(none) ", ba, bs, have ? (fr ? " FREE" : " live") : "", have && nm ? " named" : "");
+        }
+    }
+    return mcpx_apu_phys(addr);
+}
+
 const char *mcpx_apu_phys_class(uint64_t addr)
 {
     uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
@@ -1501,6 +1544,29 @@ uint64_t mcpx_apu_mmio_read(MCPXAPUState *d, uint64_t addr, unsigned int size)
