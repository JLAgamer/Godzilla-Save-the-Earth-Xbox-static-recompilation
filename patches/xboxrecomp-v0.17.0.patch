+#ifdef XBOX_INPUT_SDL3
+/* ---- SDL3 gamepads (Windows) ------------------------------------------------
+ *
+ * Built with XBOX_INPUT_SDL3 (SDL3.dll delay-loaded), and used when SDL3.dll
+ * is next to the program and RECOMP_PAD is not "xinput". SDL3 knows hundreds
+ * of pads by name and position (DualSense and DualShock over USB or
+ * Bluetooth, Switch Pro, 8BitDo, ...), so a PlayStation pad works without
+ * Steam Input or DS4Windows. Each pad goes through the pad mapping
+ * (input_map.c), which is where remapping and deadzones come from.
+ *
+ * Pads read neutral while another program's window is in front, so the
+ * launcher's overlay or another app can use the controller.
