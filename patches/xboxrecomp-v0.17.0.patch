+        raw.src[INPUT_SRC_EAST] = sdl_btn(c, SDL_GAMEPAD_BUTTON_EAST);
+        raw.src[INPUT_SRC_WEST] = sdl_btn(c, SDL_GAMEPAD_BUTTON_WEST);
+        raw.src[INPUT_SRC_NORTH] = sdl_btn(c, SDL_GAMEPAD_BUTTON_NORTH);
+        raw.src[INPUT_SRC_BACK] = sdl_btn(c, SDL_GAMEPAD_BUTTON_BACK);
+        raw.src[INPUT_SRC_GUIDE] = sdl_btn(c, SDL_GAMEPAD_BUTTON_GUIDE);
+        raw.src[INPUT_SRC_START] = sdl_btn(c, SDL_GAMEPAD_BUTTON_START);
+        raw.src[INPUT_SRC_LEFT_STICK_CLICK] = sdl_btn(c, SDL_GAMEPAD_BUTTON_LEFT_STICK);
+        raw.src[INPUT_SRC_RIGHT_STICK_CLICK] = sdl_btn(c, SDL_GAMEPAD_BUTTON_RIGHT_STICK);
+        raw.src[INPUT_SRC_LEFT_SHOULDER] = sdl_btn(c, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER);
+        raw.src[INPUT_SRC_RIGHT_SHOULDER] = sdl_btn(c, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER);
+        raw.src[INPUT_SRC_DPAD_UP] = sdl_btn(c, SDL_GAMEPAD_BUTTON_DPAD_UP);
+        raw.src[INPUT_SRC_DPAD_DOWN] = sdl_btn(c, SDL_GAMEPAD_BUTTON_DPAD_DOWN);
+        raw.src[INPUT_SRC_DPAD_LEFT] = sdl_btn(c, SDL_GAMEPAD_BUTTON_DPAD_LEFT);
+        raw.src[INPUT_SRC_DPAD_RIGHT] = sdl_btn(c, SDL_GAMEPAD_BUTTON_DPAD_RIGHT);
+        raw.src[INPUT_SRC_MISC1] = sdl_btn(c, SDL_GAMEPAD_BUTTON_MISC1);
+        raw.src[INPUT_SRC_TOUCHPAD] = sdl_btn(c, SDL_GAMEPAD_BUTTON_TOUCHPAD);
+        raw.src[INPUT_SRC_PADDLE1] = sdl_btn(c, SDL_GAMEPAD_BUTTON_RIGHT_PADDLE1);
+        raw.src[INPUT_SRC_PADDLE2] = sdl_btn(c, SDL_GAMEPAD_BUTTON_LEFT_PADDLE1);
+        raw.src[INPUT_SRC_PADDLE3] = sdl_btn(c, SDL_GAMEPAD_BUTTON_RIGHT_PADDLE2);
+        raw.src[INPUT_SRC_PADDLE4] = sdl_btn(c, SDL_GAMEPAD_BUTTON_LEFT_PADDLE2);
+        raw.src[INPUT_SRC_LEFT_TRIGGER] = pos(SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_LEFT_TRIGGER));
+        raw.src[INPUT_SRC_RIGHT_TRIGGER] = pos(SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER));
+        /* SDL's Y points down, the Xbox pad's up; -1 - v keeps -32768 in range */
+        raw.lx = SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_LEFTX);
+        raw.ly = (int16_t)(-1 - SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_LEFTY));
+        raw.rx = SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_RIGHTX);
+        raw.ry = (int16_t)(-1 - SDL_GetGamepadAxis(c, SDL_GAMEPAD_AXIS_RIGHTY));
+        raw.src[INPUT_SRC_LSTICK_UP] = pos(raw.ly);
+        raw.src[INPUT_SRC_LSTICK_DOWN] = pos(-(int)raw.ly);
+        raw.src[INPUT_SRC_LSTICK_LEFT] = pos(-(int)raw.lx);
+        raw.src[INPUT_SRC_LSTICK_RIGHT] = pos(raw.lx);
+        raw.src[INPUT_SRC_RSTICK_UP] = pos(raw.ry);
+        raw.src[INPUT_SRC_RSTICK_DOWN] = pos(-(int)raw.ry);
+        raw.src[INPUT_SRC_RSTICK_LEFT] = pos(-(int)raw.rx);
+        raw.src[INPUT_SRC_RSTICK_RIGHT] = pos(raw.rx);
+    }
+    LeaveCriticalSection(&g_sdl_lock);
+
+    if (g_padmap_set) m = g_padmap;
+    else {
+        xbox_InputMap_PadMapDefaults(&m);
+        m.deadzone_left = m.deadzone_right = m.trigger_threshold = 0;
+    }
+    xbox_InputMap_PadMap(&m, &raw, &st->Gamepad);
+    /* a new packet number whenever anything changed (the game reads edges) */
+    if (memcmp(&st->Gamepad, &g_sdl_last[port], sizeof st->Gamepad)) {
+        g_sdl_last[port] = st->Gamepad;
+        g_sdl_packet[port]++;
+    }
+    st->dwPacketNumber = g_sdl_packet[port];
+    g_controller_connected[port] = TRUE;
+    return ERROR_SUCCESS;
+}
